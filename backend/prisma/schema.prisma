// ZORA backend data model.
// Shapes mirror frontend/src/constants/mockData.ts so the UI can swap
// mock imports for API calls without reshaping any component props.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  handle         String   @unique
  // Nullable: the seeded demo user and any pre-auth rows have neither.
  // Set once on first sign-in/sign-up via /api/auth/sync.
  email          String?  @unique
  supabaseId     String?  @unique
  moodKeywords   String[]
  palette        String[]
  favoritesBrand String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  wardrobeItems WardrobeItem[]
  outfits       Outfit[]
  plannedDays   PlannedDay[]
}

model WardrobeItem {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  color     String
  colorName String
  fabric    String
  timesWorn Int      @default(0)
  lastWorn  String?
  occasions String[]
  dustOff   Boolean  @default(false)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when the item came from an uploaded photo. `imagePath` is the private
  // Supabase Storage object key — never a URL, since reads are signed per
  // request. The rest is what the vision pass read off the photo, and is what
  // the stylist reasons over (cheap text instead of re-sending images).
  imagePath  String?
  description String?
  styleTags  String[]
  pattern    String?
  seasons    String[]
  formality  Int?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]

  @@index([userId])
  @@index([userId, category])
}

model Outfit {
  id        String   @id @default(cuid())
  userId    String
  headline  String
  subhead   String?
  occasion  String?
  reasoning String[]
  forDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems OutfitItem[]
  plannedDay  PlannedDay?

  @@unique([userId, forDate])
  @@index([userId])
}

// Join row: which wardrobe items make up an outfit, and in what order.
model OutfitItem {
  id       String @id @default(cuid())
  outfitId String
  itemId   String
  position Int    @default(0)

  outfit Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item   WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([outfitId, itemId])
  @@index([outfitId])
}

model PlannedDay {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  label    String
  colors   String[]
  outfitId String?  @unique

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfit Outfit? @relation(fields: [outfitId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId])
}

model Trend {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String
  description String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
}

model CommunityPost {
  id         String   @id @default(cuid())
  handle     String
  lookName   String
  aesthetic  String
  hasSimilar Boolean  @default(false)
  color      String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Vibe {
  id       String @id @default(cuid())
  name     String @unique
  position Int    @default(0)
}
