# Local Postgres (matches the brew postgresql@14 default superuser)
DATABASE_URL="postgresql://parth@localhost:5432/zora_dev?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN="http://localhost:5173"

# ── Virtual try-on (FASHN) ─────────────────────────────────────────────
# Optional. Without it the wardrobe API runs normally and try-on returns 503.
# Paid credential — create one at https://app.fashn.ai → Developer API.
# FASHN_API_KEY=fa-xxxxxxxxxxxxxxxxxxxxxxxx
FASHN_DEFAULT_MODEL=tryon-v1.6
TRYON_TIMEOUT_MS=180000
TRYON_POLL_INTERVAL_MS=3000
# Mirror FASHN outputs to local disk. Leave off on hosts with no persistent
# disk (Render free tier) — files vanish on restart while appearing saved.
PERSIST_OUTPUTS=false

# ── Auth (Supabase) ─────────────────────────────────────────────────────
# Optional. Without these, /api/auth/* returns 503 and every request falls
# back to the seeded demo user, same as before auth existed.
# Service-role key — server-only, bypasses RLS. Never put this in the
# frontend; the frontend build uses VITE_SUPABASE_ANON_KEY instead.
# Find both under Supabase → Project Settings → API.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Stylist (Google Gemini) ─────────────────────────────────────────────
# Optional. Without a key, photo uploads skip the vision pass and
# /api/recommend falls back to deterministic scoring — both still work.
# Create one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.7-flash
# Private Storage bucket for garment photos; created automatically.
SUPABASE_WARDROBE_BUCKET=wardrobe
