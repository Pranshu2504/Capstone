# Base URL of the ZORA backend.
# Local:  http://localhost:4000  (the default when this is unset)
# Vercel: set to your Render service URL, e.g. https://zora-api.onrender.com
VITE_API_URL=http://localhost:4000

# Supabase project — find both under Project Settings → API. The anon/
# publishable key is safe to expose in a client build (it's the public half).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
