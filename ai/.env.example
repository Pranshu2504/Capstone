# ───────────────────────────────────────────────
#  ZORA backend — copy to .env and fill in
# ───────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── FASHN (required) ───────────────────────────
# Create a key at https://app.fashn.ai → Developer API → "Create new API key"
FASHN_API_KEY=fa-xxxxxxxxxxxxxxxxxxxxxxxx
FASHN_BASE_URL=https://api.fashn.ai/v1

# tryon-v1.6  → fast, ~5-17s, 1 credit/image. Best for the live mirror.
# tryon-max   → higher fidelity, 1k/2k/4k, prompt-steerable, 1-5 credits/image.
FASHN_DEFAULT_MODEL=tryon-v1.6

# ── Try-on timing ──────────────────────────────
# tryon-max at 4k/quality can take ~55s, so keep the timeout generous.
TRYON_TIMEOUT_MS=180000
TRYON_POLL_INTERVAL_MS=3000

# ── Web client ─────────────────────────────────
# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# ── Storage ────────────────────────────────────
STORAGE_DIR=storage
# FASHN's CDN deletes outputs after 3 days; mirroring them locally keeps the
# wardrobe working afterwards.
PERSIST_OUTPUTS=true

# ── Public URL & webhooks (optional) ───────────
# Only needed if this server is reachable from the internet. Without it, images
# are sent to FASHN inline as base64 data URIs and results are polled — which
# works fine on localhost.
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# FASHN_USE_WEBHOOKS=false
# FASHN_WEBHOOK_SECRET=some-long-random-string

# ── Logging ────────────────────────────────────
# LOG_LEVEL=debug
