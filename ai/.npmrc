# Build-time dependencies (typescript, @types/*) live in devDependencies, but
# `npm run build` is tsc, so the build cannot succeed without them.
#
# Hosts set NODE_ENV=production, which makes npm prune devDependencies. The
# blueprint's build command passes --include=dev, but a service created by hand
# in the Render dashboard uses the dashboard's build command instead and the
# flag is silently lost — which is exactly how this broke.
#
# Setting it here makes a plain `npm ci` correct regardless of which build
# command runs.
include=dev
